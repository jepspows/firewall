# Firewall server configuration
FIREWALL_HOST=0.0.0.0
FIREWALL_PORT=8787
FIREWALL_THRESHOLD=0.70

# ML model directory (place trained models here)
FIREWALL_MODEL_DIR=./src/firewall/models

# Per-agent rules directory
FIREWALL_RULES_DIR=./rules

# Redis for shared state (optional, multi-instance deployments)
# FIREWALL_REDIS_URL=redis://localhost:6379/0
